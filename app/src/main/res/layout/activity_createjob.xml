<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login">

    <!-- HEADER -->
    <FrameLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- BACK -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical|start"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_back"
                android:scaleType="centerInside"
                android:contentDescription="ย้อนกลับ"
                app:tint="#1F6FEB" />

        </com.google.android.material.card.MaterialCardView>

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="เพิ่มงาน"
            android:textColor="#1B3A8A"
            android:textSize="20sp"
            android:textStyle="bold" />

    </FrameLayout>


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/formCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="22dp"
        app:cardElevation="3dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ชื่องาน -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ชื่องาน"
                android:textColor="#1B2430"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="9dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="11dp"
                app:cardElevation="0dp"
                app:strokeColor="#DCE6F5"
                app:strokeWidth="1dp">

                <EditText
                    android:id="@+id/etJobTitle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:gravity="center_vertical"
                    android:hint="กรอกชื่องาน"
                    android:inputType="text"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:textColor="#1B2430"
                    android:textColorHint="#9AA3AF"
                    android:textSize="14sp" />

            </com.google.android.material.card.MaterialCardView>


            <!-- รายละเอียด -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="รายละเอียดงาน"
                android:textColor="#1B2430"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="9dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="11dp"
                app:cardElevation="0dp"
                app:strokeColor="#DCE6F5"
                app:strokeWidth="1dp">

                <EditText
                    android:id="@+id/etJobDescription"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:gravity="top|start"
                    android:hint="กรอกรายละเอียดงาน"
                    android:inputType="textMultiLine"
                    android:padding="12dp"
                    android:textColor="#1B2430"
                    android:textColorHint="#9AA3AF"
                    android:textSize="14sp" />

            </com.google.android.material.card.MaterialCardView>


            <!-- ประเภทงาน + จำนวนคน -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- ประเภทงาน -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ประเภทงาน"
                        android:textColor="#1B2430"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="5dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="11dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#DCE6F5"
                        app:strokeWidth="1dp">

                        <EditText
                            android:id="@+id/etJobType"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:gravity="center_vertical"
                            android:hint="เช่น พาร์ทไทม์"
                            android:inputType="text"
                            android:paddingStart="12dp"
                            android:paddingEnd="8dp"
                            android:textColor="#1B2430"
                            android:textColorHint="#9AA3AF"
                            android:textSize="14sp" />

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>


                <!-- จำนวนคน -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="จำนวนคน"
                        android:textColor="#1B2430"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginStart="5dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="11dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#DCE6F5"
                        app:strokeWidth="1dp">

                        <EditText
                            android:id="@+id/etPeopleCount"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:gravity="center_vertical"
                            android:hint="จำนวน"
                            android:inputType="number"
                            android:paddingStart="12dp"
                            android:paddingEnd="8dp"
                            android:textColor="#1B2430"
                            android:textColorHint="#9AA3AF"
                            android:textSize="14sp" />

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </LinearLayout>


            <!-- ค่าตอบแทน -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="ค่าตอบแทน"
                android:textColor="#1B2430"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="9dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="11dp"
                app:cardElevation="0dp"
                app:strokeColor="#DCE6F5"
                app:strokeWidth="1dp">

                <EditText
                    android:id="@+id/etSalary"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:gravity="center_vertical"
                    android:hint="ระบุค่าตอบแทน"
                    android:inputType="text"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:textColor="#1B2430"
                    android:textColorHint="#9AA3AF"
                    android:textSize="14sp" />

            </com.google.android.material.card.MaterialCardView>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="วันปฏิบัติการ"
                android:textColor="#1B2430"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="11dp"
                app:cardElevation="0dp"
                app:strokeColor="#DCE6F5"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:src="@android:drawable/ic_menu_my_calendar"
                        app:tint="#5B6675" />

                    <EditText
                        android:id="@+id/etDeadline"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:gravity="center_vertical"
                        android:hint="เช่น 05/10/2026 14:30"
                        android:inputType="text"
                        android:padding="0dp"
                        android:textColor="#1B2430"
                        android:textColorHint="#9AA3AF"
                        android:textSize="14sp" />

                    <ImageView
                        android:layout_width="11dp"
                        android:layout_height="19dp"
                        android:src="@android:drawable/ic_menu_my_calendar"
                        app:tint="#5B6675" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/btnPostJob"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_button_gradient"
                    android:clickable="true"
                    android:gravity="center"
                    android:text="ประกาศงาน"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>